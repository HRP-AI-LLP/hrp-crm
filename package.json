{
  "name": "sanchalanos",
  "private": true,
  "description": "SanchalanOS — The AI operating system for Indian businesses. By HRP AI LLP.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "pnpm --filter @synapse/db test",
    "db:migrate": "pnpm --filter @synapse/db migrate",
    "db:seed": "pnpm --filter @synapse/db seed",
    "setup": "node scripts/setup/provision.mjs",
    "cloud:setup": "node scripts/setup/provision.mjs",
    "setup:r2": "node scripts/setup/enable-r2.mjs",
    "local": "node scripts/local/local-dev.mjs",
    "local:stop": "node scripts/local/stop.mjs",
    "local:admin": "node scripts/local/admin.mjs",
    "local:test": "node scripts/local/local-test.mjs",
    "dsc": "node scripts/local/dsc-signer.mjs",
    "deploy:prod": "pnpm --filter @synapse/web build && pnpm --filter @synapse/api deploy:prod",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "gst:check": "node scripts/local/gsp-check.mjs",
    "gst:ic-account": "node scripts/local/ic-account.mjs",
    "cloud:import": "node scripts/setup/import-local.mjs"
  },
  "devDependencies": {
    "@neondatabase/api-client": "^2.7.3",
    "cloudflare": "^7.3.0",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "pg": "^8.23.1",
    "@types/pg": "^8.23.1",
    "@types/node": "^22.15.0"
  }
}
