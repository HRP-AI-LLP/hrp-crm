// HRP Synapse gateway Worker — GENERATED by `pnpm run setup` from wrangler.template.jsonc.
// Resource IDs are not secrets; commit this file so CI can deploy.
// Bindings are NOT inherited by environments in Wrangler, so each env lists them explicitly.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "synapse-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // ---- local development (`pnpm dev`): DATABASE_URL + JWT_SECRET come from apps/api/.dev.vars
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_ENV": "local",
    "BASE_DOMAIN": "localhost",
    "ALLOW_TENANT_HEADER": "true",
    "SIGNUP_ENABLED": "true",
    "CORS_ORIGINS": "http://localhost:5173",
    "AI_DAILY_LIMIT_PER_TENANT": "300"
  },

  "env": {
    // ---------------------------------------------------------------- dev (branch: dev)
    "dev": {
      "name": "synapse-dev",
      "workers_dev": true,
      "routes": [{ "pattern": "hrpsynapse-dev.hrpai.in", "custom_domain": true }],
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "vars": {
        "APP_ENV": "dev",
        "CORS_ORIGINS": "",
        "APP_HOST": "hrpsynapse-dev.hrpai.in",
        "BASE_DOMAIN": "hrpsynapse-dev.hrpai.in",
        "SAAS_CNAME_TARGET": "hrpsynapse-dev.hrpai.in",
        "CF_ACCOUNT_ID": "e2296f1c43cf81eead9fd0a8b4aa589f",
        "CF_ZONE_NAME": "hrpai.in",
        "WORKER_NAME": "synapse-dev",
        "ALLOW_TENANT_HEADER": "true",
        "SIGNUP_ENABLED": "true",
        "AI_DAILY_LIMIT_PER_TENANT": "300",
        "AI_PII_PROVIDERS": "workers-ai,groq"
      },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "58b694256b33477a90ecd3d1b83fb949" }],
      "kv_namespaces": [{ "binding": "CACHE_KV", "id": "d15da4716d9d4d0cbbc87db21b9b9edb" }],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "synapse-jobs-dev" }],
        "consumers": [{ "queue": "synapse-jobs-dev", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "synapse-jobs-dlq-dev" }]
      },
      "ai": { "binding": "AI" },
      "vectorize": [{ "binding": "VECTORIZE", "index_name": "synapse-kb-dev" }],
      "triggers": { "crons": ["17 3 * * *"] }
    },

    // ---------------------------------------------------------------- production (branch: prod)
    "production": {
      "name": "synapse-prod",
      "workers_dev": true,
      "routes": [{ "pattern": "hrpsynapse.hrpai.in", "custom_domain": true }],
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "vars": {
        "APP_ENV": "production",
        "CORS_ORIGINS": "",
        "APP_HOST": "hrpsynapse.hrpai.in",
        "BASE_DOMAIN": "hrpsynapse.hrpai.in",
        "SAAS_CNAME_TARGET": "hrpsynapse.hrpai.in",
        "CF_ACCOUNT_ID": "e2296f1c43cf81eead9fd0a8b4aa589f",
        "CF_ZONE_NAME": "hrpai.in",
        "WORKER_NAME": "synapse-prod",
        "ALLOW_TENANT_HEADER": "false",
        "SIGNUP_ENABLED": "true",
        "AI_DAILY_LIMIT_PER_TENANT": "300",
        "AI_PII_PROVIDERS": "workers-ai,groq"
      },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "544010787c534b9687c1f083e64459ab" }],
      "kv_namespaces": [{ "binding": "CACHE_KV", "id": "f11b241adaf041da8801bb2815415cd7" }],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "synapse-jobs-prod" }],
        "consumers": [{ "queue": "synapse-jobs-prod", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "synapse-jobs-dlq-prod" }]
      },
      "ai": { "binding": "AI" },
      "vectorize": [{ "binding": "VECTORIZE", "index_name": "synapse-kb-prod" }],
      "triggers": { "crons": ["17 3 * * *"] }
    }
  }
}
