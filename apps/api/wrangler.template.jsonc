// SanchalanOS gateway Worker — TEMPLATE.
// `pnpm run setup` renders this into wrangler.jsonc with your real resource IDs. Edit this file,
// not wrangler.jsonc, then re-run setup (or replace the __PLACEHOLDERS__ by hand).
//
// Two environments only:
//   dev  → this computer (`pnpm local`, apps/api/wrangler.local.jsonc, Postgres in a container)
//   prod → Cloudflare + Neon (`--env production`, deployed from the GitHub "main" branch)
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sanchalanos-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // ---- `wrangler dev` without an env (the same settings as `pnpm local`)
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/assetlinks.json"]
  },
  "vars": {
    "APP_ENV": "local",
    "BASE_DOMAIN": "localhost",
    "ALLOW_TENANT_HEADER": "true",
    "SIGNUP_ENABLED": "true",
    "CORS_ORIGINS": "http://localhost:5173",
    "AI_DAILY_LIMIT_PER_TENANT": "300"
  },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "synapse-files-local" }],

  "env": {
    // ---------------------------------------------------------------- production (branch: main)
    "production": {
      "name": "sanchalanos",
      // the app is served only on its own domain (no *.workers.dev copy to keep warm or secure)
      "workers_dev": false,
      "preview_urls": false,
      // __PROD_ROUTES__
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/.well-known/assetlinks.json"]
      },
      // logs on, sampled: enough to debug, well inside the free allowance
      "observability": { "enabled": true, "head_sampling_rate": 0.2 },
      "vars": {
        "APP_ENV": "production",
        "CORS_ORIGINS": "",
        "APP_HOST": "__PROD_APP_HOST__",
        "BASE_DOMAIN": "__PROD_BASE_DOMAIN__",
        "SAAS_CNAME_TARGET": "__PROD_APP_HOST__",
        "MAIL_FROM": "SanchalanOS <no-reply@hrpai.in>",
        "VAPID_SUBJECT": "mailto:info@hrpai.in",
        "CF_ACCOUNT_ID": "__CF_ACCOUNT_ID__",
        "CF_ZONE_NAME": "__ZONE_NAME__",
        "WORKER_NAME": "sanchalanos",
        "ALLOW_TENANT_HEADER": "false",
        "SIGNUP_ENABLED": "true",
        "AI_DAILY_LIMIT_PER_TENANT": "300",
        "AI_PII_PROVIDERS": "workers-ai,groq"
      },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "__PROD_HYPERDRIVE_ID__" }],
      "kv_namespaces": [{ "binding": "CACHE_KV", "id": "__PROD_KV_ID__" }],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "synapse-jobs-prod" }],
        "consumers": [{ "queue": "synapse-jobs-prod", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "synapse-jobs-dlq-prod" }]
      },
      "ai": { "binding": "AI" },
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "synapse-files-prod" }],
      "vectorize": [{ "binding": "VECTORIZE", "index_name": "synapse-kb-prod" }],
      // 03:17 UTC daily housekeeping + a 5-minute tick that reads KV first and wakes the database
      // only when something is due (see apps/api/src/services/cron-plan.ts)
      "triggers": { "crons": ["17 3 * * *", "*/5 * * * *"] }
    }
  }
}
