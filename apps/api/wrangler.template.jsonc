// HRP Synapse gateway Worker — TEMPLATE.
// `pnpm run setup` renders this into wrangler.jsonc with your real resource IDs. Edit this file,
// not wrangler.jsonc, then re-run setup (or replace the __PLACEHOLDERS__ by hand).
// Bindings are NOT inherited by environments in Wrangler, so each env lists them explicitly.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "synapse-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // ---- local development (`pnpm dev`): DATABASE_URL + JWT_SECRET come from apps/api/.dev.vars
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_ENV": "local",
    "BASE_DOMAIN": "localhost",
    "ALLOW_TENANT_HEADER": "true",
    "SIGNUP_ENABLED": "true",
    "CORS_ORIGINS": "http://localhost:5173",
    "AI_DAILY_LIMIT_PER_TENANT": "300"
  },

  "env": {
    // ---------------------------------------------------------------- dev (branch: dev)
    "dev": {
      "name": "synapse-dev",
      "workers_dev": true,
      // __DEV_ROUTES__
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "vars": {
        "APP_ENV": "dev",
        "CORS_ORIGINS": "",
        "APP_HOST": "__DEV_APP_HOST__",
        "BASE_DOMAIN": "__DEV_APP_HOST__",
        "SAAS_CNAME_TARGET": "__DEV_APP_HOST__",
        "CF_ACCOUNT_ID": "__CF_ACCOUNT_ID__",
        "CF_ZONE_NAME": "__ZONE_NAME__",
        "WORKER_NAME": "synapse-dev",
        "ALLOW_TENANT_HEADER": "true",
        "SIGNUP_ENABLED": "true",
        "AI_DAILY_LIMIT_PER_TENANT": "300",
        "AI_PII_PROVIDERS": "workers-ai,groq"
      },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "__DEV_HYPERDRIVE_ID__" }],
      "kv_namespaces": [{ "binding": "CACHE_KV", "id": "__DEV_KV_ID__" }],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "synapse-jobs-dev" }],
        "consumers": [{ "queue": "synapse-jobs-dev", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "synapse-jobs-dlq-dev" }]
      },
      "ai": { "binding": "AI" },
      "vectorize": [{ "binding": "VECTORIZE", "index_name": "synapse-kb-dev" }],
      "triggers": { "crons": ["17 3 * * *"] }
    },

    // ---------------------------------------------------------------- production (branch: prod)
    "production": {
      "name": "synapse-prod",
      "workers_dev": true,
      // __PROD_ROUTES__
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "vars": {
        "APP_ENV": "production",
        "CORS_ORIGINS": "",
        "APP_HOST": "__PROD_APP_HOST__",
        "BASE_DOMAIN": "__PROD_APP_HOST__",
        "SAAS_CNAME_TARGET": "__PROD_APP_HOST__",
        "CF_ACCOUNT_ID": "__CF_ACCOUNT_ID__",
        "CF_ZONE_NAME": "__ZONE_NAME__",
        "WORKER_NAME": "synapse-prod",
        "ALLOW_TENANT_HEADER": "false",
        "SIGNUP_ENABLED": "true",
        "AI_DAILY_LIMIT_PER_TENANT": "300",
        "AI_PII_PROVIDERS": "workers-ai,groq"
      },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "__PROD_HYPERDRIVE_ID__" }],
      "kv_namespaces": [{ "binding": "CACHE_KV", "id": "__PROD_KV_ID__" }],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "synapse-jobs-prod" }],
        "consumers": [{ "queue": "synapse-jobs-prod", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "synapse-jobs-dlq-prod" }]
      },
      "ai": { "binding": "AI" },
      "vectorize": [{ "binding": "VECTORIZE", "index_name": "synapse-kb-prod" }],
      "triggers": { "crons": ["17 3 * * *"] }
    }
  }
}
