+  const tzid = params.TZID.replace(/^"|"$/g, '');
+  const iana = WINDOWS_TZ[tzid] ?? tzid;
+  let off = zoneOffset(iana, new Date(naive));
+  if (off !== null) off = zoneOffset(iana, new Date(naive - off * 60_000)) ?? off;
+  if (off === null) off = zones.get(tzid) ?? 0;
