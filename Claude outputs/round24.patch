+      const full = await providerFetch<{ contentBytes?: string }>(`${GRAPH}/me/messages/${m.id}/attachments/${a.id}`, { headers: auth }).catch(() => null);
+      if (full?.contentBytes) out.push(...parseIcs(b64url(full.contentBytes)));
+    }
+  }
+  return out;
