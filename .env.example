# Copy to .env (git-ignored) and fill in. `pnpm local` reads it; nothing here is printed.

# GST portal, e-invoice and e-way bill through the WhiteBooks GSP (developer.whitebooks.in → API keys)
WHITEBOOKS_ENV=sandbox
WHITEBOOKS_EMAIL=
WHITEBOOKS_CLIENT_ID=
WHITEBOOKS_CLIENT_SECRET=
# only if WhiteBooks issued separate keys for these products
WHITEBOOKS_EINVOICE_CLIENT_ID=
WHITEBOOKS_EINVOICE_CLIENT_SECRET=
WHITEBOOKS_EWAYBILL_CLIENT_ID=
WHITEBOOKS_EWAYBILL_CLIENT_SECRET=

# optional AI providers (otherwise rule-based fallbacks)
GROQ_API_KEY=
GEMINI_API_KEY=
