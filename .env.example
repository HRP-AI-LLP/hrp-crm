# Copy to .env (git-ignored) and fill in. `pnpm local` reads it; nothing here is printed.

# GST portal, e-invoice and e-way bill through a GST Suvidha Provider.
# India Compliance (pay per call): run `pnpm gst:ic-account signup <email> <GSTIN>`, then `finish` — it fills these in.
GST_PROVIDER=indiacompliance
INDIA_COMPLIANCE_API_SECRET=
# true: e-invoice / e-way bill go to India Compliance's test servers (returns always go to the live portal)
INDIA_COMPLIANCE_TEST_MODE=

# WhiteBooks (developer.whitebooks.in → API keys); used when GST_PROVIDER=whitebooks
WHITEBOOKS_ENV=sandbox
WHITEBOOKS_EMAIL=
WHITEBOOKS_CLIENT_ID=
WHITEBOOKS_CLIENT_SECRET=
# only if WhiteBooks issued separate keys for these products
WHITEBOOKS_EINVOICE_CLIENT_ID=
WHITEBOOKS_EINVOICE_CLIENT_SECRET=
WHITEBOOKS_EWAYBILL_CLIENT_ID=
WHITEBOOKS_EWAYBILL_CLIENT_SECRET=

# optional AI providers (otherwise rule-based fallbacks)
GROQ_API_KEY=
GEMINI_API_KEY=
