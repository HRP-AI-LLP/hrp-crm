# Copy to .env (git-ignored) and fill in. `pnpm local` reads it; nothing here is printed.

# GST portal, e-invoice and e-way bill through a GST provider.
# gstinapi.in (recommended): the API key from https://www.gstinapi.in/dashboard
GST_PROVIDER=gstinapi
GSTINAPI_KEY=
# true: every call is a free synthetic test (nothing reaches the GST network); connecting still sends a real OTP
GSTINAPI_TEST_MODE=

# India Compliance: `pnpm gst:ic-account signup <email> <GSTIN>`, then `finish`; used when GST_PROVIDER=indiacompliance
INDIA_COMPLIANCE_API_SECRET=
# true: e-invoice / e-way bill go to India Compliance's test servers (returns always go to the live portal)
INDIA_COMPLIANCE_TEST_MODE=

# WhiteBooks (developer.whitebooks.in → API keys); used when GST_PROVIDER=whitebooks
WHITEBOOKS_ENV=sandbox
WHITEBOOKS_EMAIL=
WHITEBOOKS_CLIENT_ID=
WHITEBOOKS_CLIENT_SECRET=
# only if WhiteBooks issued separate keys for these products
WHITEBOOKS_EINVOICE_CLIENT_ID=
WHITEBOOKS_EINVOICE_CLIENT_SECRET=
WHITEBOOKS_EWAYBILL_CLIENT_ID=
WHITEBOOKS_EWAYBILL_CLIENT_SECRET=

# optional AI providers (otherwise rule-based fallbacks)
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional fallbacks. These keys are normally set in the app: Settings → Connection keys (with a guide for each).
# A value saved there replaces the one here.
# meeting apps and mailboxes (OAuth apps registered by you — see docs/INTEGRATIONS.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# GitHub App: repository picker, checks on pull requests, branches (docs/INTEGRATIONS.md → GitHub App)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# the PEM on one line, line breaks written as \n
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
